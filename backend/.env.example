# Copy to .env. Read by docker compose and by `bun dev` outside docker
# (DATABASE_URL and PORT only matter outside docker, compose overrides them)
DATABASE_URL=postgresql://lasuite:lasuite@localhost:5432/tasks
PORT=3001
# Free "Experiment" key from https://console.mistral.ai (speech-to-text + task extraction)
MISTRAL_API_KEY=
# Comma-separated browser origins allowed to call the API (e.g. the Docs frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:8088
